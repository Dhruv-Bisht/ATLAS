# Required only when using the persistent database / production ingestion.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/atlas?sslmode=require"
CRON_SECRET="change-me"

# ScholarshipAPI intentionally disabled for V2. Add in a future version if needed.

# Optional. Adzuna requires a free developer registration and supplies app_id/app_key.
# ATLAS works without these because Arbeitnow + Himalayas require no API key.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Optional free-tier integrations. Keep all secrets server-side.
SERPAPI_KEY=""
FIRECRAWL_API_KEY=""
APIFY_API_TOKEN=""

# Optional source attribution / contact identity for future geocoding adapters.
GEOCODER_USER_AGENT="ATLAS/1.0 contact@example.com"
